#!/bin/sh
mode="$1"
{
    if [ "$mode" = refresh ]; then
        printf '\0338\033[0J'
    else
        printf '\0337'
    fi
    printf '\nrk3588 AIUI Recovery\n'
    printf 'Web: '
    ip -4 -o addr show scope global | awk '{split($4,a,"/"); printf "http://%s/  ",a[1]}'
    printf '\nSSH / serial login: root / root\n\n'
} > /etc/issue.tmp
if cmp -s /etc/issue.tmp /etc/issue 2>/dev/null; then
    rm -f /etc/issue.tmp
    exit 0
fi
mv /etc/issue.tmp /etc/issue
# Redraw only the banner below the kernel logo, like the upstream recovery.
if [ "$mode" = refresh ]; then
    for pid in $(pidof getty); do
        tty=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null |
            awk '{for(i=1;i<=NF;i++) if($i ~ /^tty/) print $i}')
        case "$tty" in
            tty1) kill "$pid" 2>/dev/null ;;
        esac
    done
fi
